# Base URL of the Quartermaster Express API. The web app proxies /api/* here so the
# session cookie stays first-party. Read when `next dev` / `next build` / `next start` boots.
API_URL=http://localhost:4000

# Set to "false" to hide the seeded demo accounts on the sign-in page (inlined at build time).
NEXT_PUBLIC_DEMO_ACCOUNTS=true
