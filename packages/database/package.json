{
  "name": "@qm/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL system of record: Drizzle schema, migrations, client factory and demo seed.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@qm/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11"
  }
}
