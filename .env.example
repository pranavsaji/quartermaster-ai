# ---------------------------------------------------------------------------
# Quartermaster AI + TrustRail — environment variables
# Copy to .env and fill in. NEVER commit .env. Secrets live only here or in your
# hosting provider's secret store.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
# Comma-separated origins allowed to call the API directly (the web app normally proxies).
CORS_ORIGINS=
# Reverse proxies in front of the API: a hop count (0-5) or a comma-separated list of trusted
# proxy IPs/CIDRs. Render with the web app proxying /api: 2 (edge + Next.js). A subnet list is
# stricter, because the API is also reachable directly for PayPal webhooks.
TRUST_PROXY=0
# Request rate limits (per client IP unless stated). Defaults: 300/min overall, sign-in 10 per
# 15 min per IP + email and 100 per 15 min per IP, webhooks 120/min.
# RATE_LIMIT_PER_MINUTE=
# LOGIN_RATE_LIMIT_PER_ACCOUNT=
# LOGIN_RATE_LIMIT_PER_IP=
# WEBHOOK_RATE_LIMIT_PER_MINUTE=
# How long shutdown waits for in-flight requests and a running sweep (ms).
SHUTDOWN_GRACE_MS=60000

# Database. Leave unset in development to use embedded PGlite under ./.data.
# DATABASE_URL=postgres://user:pass@localhost:5432/quartermaster
# require (production default) or disable. Production refuses disable unless
# DATABASE_ALLOW_INSECURE_TRANSPORT=true (only for a provider's private network).
DATABASE_SSL=disable
# DATABASE_ALLOW_INSECURE_TRANSPORT=false
# DATABASE_CA_CERT=

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# TrustRail Ed25519 signing key — generate with `pnpm keys:generate`.
TRUSTRAIL_SIGNING_KEY_ID=
TRUSTRAIL_SIGNING_KEY=

# PayPal sandbox (developer.paypal.com → Apps & Credentials, Sandbox).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's webhook configuration (needed for signature verification).
# Required in production whenever PayPal is configured.
PAYPAL_WEBHOOK_ID=
# Merchant account id; captures to any other payee are refused. Required in production with PayPal.
PAYPAL_MERCHANT_ID=
PAYPAL_BRAND_NAME=Quartermaster Sandbox Suppliers

# Channel3 product search (market price evidence). Leave empty to run without market data.
CHANNEL3_API_KEY=

# OpenAI structured outputs. Leave empty to run in deterministic mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional Zapier Catch Hook for notification-only alerts.
ZAPIER_WEBHOOK_URL=

# Agent limits
AGENT_MAX_RESEARCH_CALLS=8
AGENT_DEADLINE_MS=45000
AGENT_TOKEN_BUDGET=12000
MARKET_REFERENCE_MAX_AGE_HOURS=72

# Background sweeper interval inside the API process (0 disables; use the cron job instead).
SWEEPER_INTERVAL_SECONDS=60
# Lets managers mark synthetic deliveries received or delayed. Defaults to true outside
# production and false in production.
ALLOW_SYNTHETIC_DELIVERY_ACTIONS=true

# Password for the shared sample workspace owner@/manager@/viewer@demo.quartermaster.dev (min 12
# chars). `pnpm db:seed` creates it once; it is never reset unless you pass --reset.
DEMO_USER_PASSWORD=

# --- Accounts ---------------------------------------------------------------------------------
# Anyone may create a workspace at /signup (default true). Sign-ups per IP per hour (default 5).
SIGNUP_ENABLED=true
# Show the sample-workspace accounts on the sign-in page (default: off in production, on elsewhere).
SAMPLE_ACCOUNTS_HINT=
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Email for invitations, password resets and alerts, over HTTPS. Without a provider, owners copy
# invitation and reset links from the Team page, and "Forgot password" is hidden.
# Resend (https://resend.com): an API key and a verified sender.
RESEND_API_KEY=
EMAIL_FROM=Quartermaster <onboarding@resend.dev>
# Or any endpoint that accepts { to, subject, text, html } JSON (e.g. Zapier "Email by Zapier").
EMAIL_WEBHOOK_URL=

# --- Monitoring -------------------------------------------------------------------------------
# Platform operators (comma-separated emails) see the System page: tracked errors and health.
OPERATOR_EMAILS=
# Alert recipients (needs email) and/or a Slack-compatible incoming webhook ({ text }).
ALERT_EMAILS=
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=30
# Optional: also forward errors to Sentry (sanitised envelopes only).
SENTRY_DSN=

# --- Operations -------------------------------------------------------------------------------
# Notifications: zapier | email (each workspace's owners, via the email provider above) | both.
# Unset: both with RESEND_API_KEY and ZAPIER_WEBHOOK_URL, email with only RESEND_API_KEY, else zapier.
# NOTIFY_CHANNEL=email
# Apply migrations when the API starts (default true; false in production, where the pre-deploy
# command migrates).
# MIGRATE_ON_BOOT=true
# Alert (monitor.sweeper_stale) after this long without a successful sweep. Default 3x the sweeper
# interval (3x 5 minutes when SWEEPER_INTERVAL_SECONDS=0); 0 disables.
# SWEEPER_STALE_AFTER_SECONDS=180
# Days to keep webhook events, agent tool steps, error groups and expired one-time links.
RETENTION_DAYS=90
# OpenAI/Channel3 circuit breaker: consecutive failures before calls are skipped (0 disables), and for how long.
PROVIDER_BREAKER_THRESHOLD=3
PROVIDER_BREAKER_COOLDOWN_SECONDS=120
# Per-workspace cache of the analytics summary, in seconds (default 30, 0 in tests; 0 disables).
# ANALYTICS_CACHE_SECONDS=30
# --- Security hardening (all optional; defaults shown suit production) -------------------------
# Shared secret the web proxy sends as X-QM-Edge (set the same value on web and API, 16+ chars).
# With it, X-Forwarded-For is believed only on requests from the web app; direct callers are
# limited by their socket address.
#EDGE_SECRET=
# Shared sample workspace: account/team/mandate/supplier changes refused (default true; false in tests).
#SAMPLE_WORKSPACE_READONLY=true
# Reset the shared sample workspace every day at this UTC hour (0-23). Unset: never.
#SAMPLE_RESET_HOUR_UTC=9
# Daily caps on paid research (OpenAI + Channel3); beyond them research runs deterministically.
#RESEARCH_DAILY_RUNS_PER_ORG=40
#RESEARCH_DAILY_RUNS_GLOBAL=600
#RESEARCH_DAILY_TOKENS_GLOBAL=6000000
# Invitations per workspace per hour / per day; red-team runs per user / per workspace per minute.
#INVITE_RATE_LIMIT_PER_HOUR=20
#INVITE_RATE_LIMIT_PER_DAY=100
#RED_TEAM_RATE_LIMIT_PER_USER=30
#RED_TEAM_RATE_LIMIT_PER_ORG=120
# Sessions unused this long end (minutes; 0 = never).
#SESSION_IDLE_MINUTES=120
# PayPal webhook signature verifications per minute, platform-wide.
#WEBHOOK_VERIFY_GLOBAL_PER_MINUTE=300
