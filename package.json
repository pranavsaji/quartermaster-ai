{
  "name": "quartermaster-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Quartermaster AI \u2014 autonomous purchasing for small businesses, secured by TrustRail.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @qm/api --filter @qm/web dev",
    "build": "pnpm --filter @qm/api build && pnpm --filter @qm/web build",
    "start:api": "pnpm --filter @qm/api start",
    "start:web": "pnpm --filter @qm/web start",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @qm/database generate",
    "db:migrate": "pnpm --filter @qm/database migrate",
    "db:seed": "pnpm --filter @qm/database seed",
    "db:reset": "pnpm --filter @qm/database reset",
    "keys:generate": "tsx scripts/generate-signing-key.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@qm/api": "workspace:*",
    "@qm/contracts": "workspace:*",
    "@qm/database": "workspace:*",
    "@qm/integrations": "workspace:*",
    "@qm/payments": "workspace:*",
    "@qm/quartermaster": "workspace:*",
    "@qm/trustrail": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "drizzle-orm": "^0.45.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
